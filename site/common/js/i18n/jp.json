            "project06": {
                "left": {
                    "project_name": "自動車 / 部品在庫管理システム開発支援",
                    "period": "2024.06 - 2025.03",
                    "position": "SE / PG",
                    "overview": "自動車製造工程における部品在庫をリアルタイムに管理する業務システムの開発支援に参画。在庫管理業務の効率化を目的として、画面機能の開発・改修、各種設計書の整備、テスト対応まで幅広く担当。"
                },
                "center": {
                    "content": [
                        "部品在庫情報の検索・登録・出庫管理機能の設計支援および実装対応",
                        "発注処理・配送状況トラッキング機能の開発および改修対応",
                        "統計画面における在庫推移・部品使用実績グラフ表示機能の対応",
                        "DBテーブル定義書、ER図、画面遷移・インターフェース関連資料の作成・改訂",
                        "共通部品・共通CSSの改修、および画面間の共通化対応",
                        "単体テスト・結合テスト・総合テスト仕様書の作成、不具合調査・改修対応",
                        "関係者と連携しながら、開発からテストまで一連の工程を支援"
                    ]
                },
                "right": {
                    "os": "Windows",
                    "language": "HTML / CSS / TypeScript / Java",
                    "framework": "React / Bootsrap / SpringBoot / SpringBatch",
                    "ide": "VS Code / Eclipse",
                    "db": "Oracle",
                    "cloud": "AWS",
                    "tools": "SVN"
                }
            },
            "project07": {
                "left": {
                    "project_name": "金融 / 口座管理システム",
                    "period": "2025.04 - 2025.12",
                    "position": "PG",
                    "overview": "銀行向け口座管理システムの二次開発プロジェクトに参画。印鑑届・本人確認情報・KYCDBの統合管理および外部端末とのデータ連携を通じて、業務の精度向上と効率化を支援。"
                },
                "center": {
                    "content": [
                        "外部端末IF基盤の検証およびデータ連携フローの最適化",
                        "Shell／VBAツールのパラメータ設計、共通化、スクリプト改修",
                        "SFTP鍵認証（秘密鍵／MAC設定）を含む外部連携環境構築支援",
                        "Hinemos／Systemwalkerによるバッチ処理解析、ログ調査、問題切り分け",
                        "単体テスト・結合テスト・総合テスト仕様書の作成および不具合対応",
                        "IF仕様書・処理フロー改善による品質向上",
                        "PostgreSQLのスキーマ／関数確認、大規模データ準備、連携プロセス検証",
                        "チェックアップロード～取込までの一連処理の検証"
                    ]
                },
                "right": {
                    "os": "Windows / Linux",
                    "language": "Shell / Java / VBA / VBS",
                    "framework": "Spring Boot / Spring Batch",
                    "ide": "Eclipse",
                    "db": "PostgreSQL",
                    "cloud": "-",
                    "tools": "Git / Hinemos / Systemwalker"
